name: nightly

on:
  push:
    branches:
      - main
      - master
    tags:
      - 'v*'
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    env:
      NAME: FLAC Bridge Multi Extension
      TAG: echo_flac_bridge
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Setup JDK 21
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: 21
          cache: 'gradle'

      - name: Cook Env
        run: |
          echo -e "## ${{ env.NAME }}\n${{ github.event.head_commit.message }}" > commit.txt
          ver_name=$(grep '^extVersionName=' gradle.properties | cut -d'=' -f2 | tr -d '[:space:]')
          if [[ "${{ github.ref }}" == refs/tags/v* ]]; then
            VERSION="${GITHUB_REF#refs/tags/}"
          elif [ -n "$ver_name" ]; then
            VERSION="$ver_name"
          else
            version=$( echo ${{ github.event.head_commit.id }} | cut -c1-7 )
            VERSION="v$version"
          fi
          echo "VERSION=$VERSION" >> $GITHUB_ENV
          echo "APP_PATH=app/build/${{ env.TAG }}-$VERSION.eapk" >> $GITHUB_ENV
          
          if [ -n "${{ secrets.KEYSTORE_B64 }}" ]; then
            echo "${{ secrets.KEYSTORE_B64 }}" | base64 -d > $GITHUB_WORKSPACE/signing-key.jks
            echo "KEY_PASS=${{ secrets.PASSWORD }}" >> $GITHUB_ENV
          else
            keytool -genkeypair -keystore $GITHUB_WORKSPACE/signing-key.jks -storetype PKCS12 -alias key0 -keyalg RSA -keysize 2048 -validity 10000 -storepass echoflacbridge -keypass echoflacbridge -dname "CN=FLAC Bridge Multi, OU=Echo Extension, O=TheWinner02, C=IT"
            echo "KEY_PASS=echoflacbridge" >> $GITHUB_ENV
          fi
          chmod +x ./gradlew

      - name: Build with Gradle
        run: |
          ./gradlew assembleRelease \
          -Pandroid.injected.signing.store.file=$GITHUB_WORKSPACE/signing-key.jks \
          -Pandroid.injected.signing.store.password=${{ env.KEY_PASS }} \
          -Pandroid.injected.signing.key.alias=key0 \
          -Pandroid.injected.signing.key.password=${{ env.KEY_PASS }}
          
          mkdir -p app/build
          cp app/build/outputs/apk/release/app-release.apk ${{ env.APP_PATH }}

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          path: ${{ env.APP_PATH }}

      - name: Create Release
        uses: softprops/action-gh-release@v2
        with:
          make_latest: true
          tag_name: ${{ env.VERSION }}
          body_path: commit.txt
          name: ${{ env.VERSION }}
          files: ${{ env.APP_PATH }}

      - name: Delete Old Releases
        uses: sgpublic/delete-release-action@master
        with:
          release-drop: true
          release-keep-count: 3
          release-drop-tag: true
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Upload APK to Discord
        shell: bash
        if: ${{ env.WEBHOOK != '' }}
        env:
          WEBHOOK: ${{ secrets.DISCORD_WEBHOOK }}
        run: |
          commit=$(jq -Rsa . <<< "${{ github.event.head_commit.message }}"  | tail -c +2 | head -c -2)
          message=$(echo "@everyone **${{ env.VERSION }}**\n$commit")
          curl -F "payload_json={\"content\":\"${message}\"}" \
          -F "file=@${{ env.APP_PATH }}" \
          ${{ env.WEBHOOK }}

      - name: Upload APK to Telegram
        shell: bash
        if: ${{ env.BOT_ID != '' && env.CHANNEL_ID != '' }}
        env:
          BOT_ID: ${{ secrets.TELEGRAM_BOT_ID }}
          CHANNEL_ID: ${{ secrets.TELEGRAM_CHANNEL_ID }}
          THREAD_ID: ${{ secrets.TELEGRAM_THREAD_ID }}
        run: |
          message=$(echo -e "${{ env.NAME }}\n$(echo -e "${{ github.event.head_commit.message }}" | sed 's/[~>|.!+-=#]/\\&/g')")
          curl -F "chat_id=${{ env.CHANNEL_ID }}" \
          -F "message_thread_id=${{ env.THREAD_ID }}" \
          -F "document=@${{ env.APP_PATH }}" \
          -F "caption=${message}" \
          -F "parse_mode=MarkdownV2" \
          https://api.telegram.org/bot${{ env.BOT_ID }}/sendDocument
